# Copy to /etc/zhanmen/env and fill in. Never commit the filled file.
# BETTER_AUTH_URL must be the exact public URL, including the port.
# Use http:// while the panel has no TLS. https:// turns on Secure cookies and login breaks.
BETTER_AUTH_URL=http://YOUR_PUBLIC_IP:8443
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
PGLITE_DATA_DIR=/var/lib/zhanmen/pg
PUBLIC_PORT=8443
PANEL_UPSTREAM_PORT=8081

# Read these from the existing 3x-ui REALITY inbound. Do not put the private key here.
XRAY_HOST=YOUR_PUBLIC_IP
XRAY_PORT=443
XRAY_SNI=www.microsoft.com
XRAY_PUBLIC_KEY=
XRAY_SHORT_ID=
XRAY_FLOW=xtls-rprx-vision
XRAY_SPIDERX=/
XRAY_SYNC=/opt/zhanmen/scripts/xray-sync.py
